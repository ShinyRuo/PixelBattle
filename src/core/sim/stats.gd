class_name PBStats
extends RefCounted
## 一个单位**此刻**的属性快照。§03A，M3.5-a。
##
## ## 两层，而且只有一条链路
##
## - **基础属性**（血 / 蓝 / 攻 / 防 / 攻速）—— 战斗结算只读这五个
## - **二级属性**（力量 / 敏捷 / 智力）—— **只通过系数影响基础属性**，
##   不直接进任何伤害公式
##
## 二级不直接参战是有意的：只有一条链路时，「加点力量」的后果才说得清
## （力量 → 血 → 更扛打）。两层都进公式的话，一次调参会同时从两个方向
## 改同一件事，那种耦合调不动 —— 而本案的数值回归还没开始，
## 现在留下这种耦合等于给后面挖坑。
##
## ## 为什么是一个值包，不是一个有行为的类
##
## 它是**算出来的结果**，不是状态：等级、星级、装备、羁绊、尾兽光环
## 任何一样变了都要重算。带行为的话总会有人往里塞一个「当前血量」，
## 而那是战斗层的东西，一波打完就没了 —— 混在一起会让「这张卡有多强」
## 和「这个单位还剩多少血」共用一个对象，存档时必然出错。
##
## 算它的是 [PBStatRules]，本类只负责装。

var hp: float = 0.0
var mp: float = 0.0
var atk: float = 0.0
var def: float = 0.0

## 每秒攻击几次。[member atk] × 本值 = 每秒伤害，也就是 M1 以来的那个「战力」。
var attack_speed: float = 1.0

var strength: float = 0.0
var agility: float = 0.0
var intellect: float = 0.0


## 每秒伤害。**这是新旧模型的接缝** —— M1 到 M3 的 `power` 就是这个量，
## 所以战斗层、估值、界面全都不用改口径。
func dps() -> float:
	return atk * attack_speed
