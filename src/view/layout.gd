class_name PBLayout
extends RefCounted
## 界面十个区块的坐标。**全项目唯一一份。**
##
## ## 为什么要收成一处
##
## 在这之前，屏幕上每一块的矩形写在它自己的文件里（六个 `PANEL_RECT`
## 加 [PBEnemyPool] 那三个战场常量加 [PBFieldSlots] 那一串 `_Y`）。
## 那样写单块看着很自然，**代价是「屏幕排得下吗」这个问题没有地方问** ——
## 要挪一块就得先去六个文件里把邻居的坐标抄出来，抄漏一个就重叠，
## 而重叠**单元测试抓不到，只能截图**（M2-d 的羁绊带就和下一波预告叠过一次）。
##
## 收成一处之后，这个文件本身就是那张排版图：从上往下读一遍就知道
## 谁在谁旁边、还剩多少空隙。
##
## ## 十个区块
##
## ```
## ┌─────────────────────────────────────────┐
## │ ┌──┐ ┌─── A 本局信息 ────────────────┐ │
## │ │C │ ├───────────────────────────────┤ │
## │ │尾│ │                               │ │
## │ └──┘ │                               │ │
## │ ┌──┐ │        B 战场                 │ │
## │ │D │ │                               │ │
## │ │基│ │      （模态弹层摊在这上面）    │ │
## │ └──┘ │                               │ │
## │ ┌──┐ │                               │ │
## │ │E │ │                               │ │
## │ │任│ │                               │ │
## │ │+4│ │                               │ │
## │ └──┘ └───────────────────────────────┘ │
## │ ┌────┐┌───┐┌────┐┌┐┌──────┐            │
## │ │ F  ││ G ││ H  ││I││  J   │            │
## │ │仓库││忍具││信息││装││操作 │            │
## │ └────┘└───┘└────┘└┘└──────┘            │
## └─────────────────────────────────────────┘
## ```
##
## ## 640×360 是硬约束
##
## 视口就这么大（`project.godot` 的 `viewport_width/height`，窗口 1280×720
## 是它放大两倍）。字号 8–9，一个汉字约 8 像素宽 —— 所以一块 130 像素宽的
## 面板一行只写得下 16 个汉字。**长句一律进 tooltip，面板上只留数字和图标**，
## 那不是风格选择，是这张表算出来的结论。
##
## **超出去不报错。** 溢出的那一截只是画在屏幕外，跑起来一切正常 ——
## M5-2 到 M5-5 期间两块抽屉一直伸出屏幕 65 像素（带子从 588 窄到 508，
## 而卡的步距还是老的），没有任何一条测试红过。所以
## `test_layout.gd` 把 [constant SCREEN] 钉成了一条断言。

## 视口尺寸。**这里的每一个矩形都必须落在它里面**，见类顶部最后一段。
const SCREEN := Vector2(640.0, 360.0)

# ── A 顶栏：本局信息 ────────────────────────────────────────────

## 出战人口 M/N、金币、波次、下一波。**两行合并成一行** ——
## 在这之前「本波信息」在顶上、「下一波预告」在战场下面，
## 中间隔着整个战场，玩家要在两处之间来回扫。
##
## **横跨整个屏幕宽度，不跟 B 对齐。** 草图上它从 B 的左沿起，
## 但左上角那块（C 上面）本来就是空的，而这一行是全屏最长的一句话 ——
## 对齐好看，代价是右端截掉「A 自动:关」那几个字。
const A_INFO := Rect2(8.0, 3.0, 624.0, 12.0)

## 下一波预告。**在这之前它单独占战场下面那一行（y232）** ——
## 「本波」在屏幕最上、「下一波」在屏幕中间，隔着整个战场，
## 玩家要在两处之间来回扫。现在两行贴在一起。
const A_PREVIEW := Rect2(8.0, 15.0, 624.0, 12.0)

## 顶栏两行的字号。**比原来的 11 小** —— 顶栏从 624 像素窄到 512，
## 那一行本来就快写满了，不缩字号会直接截断。
const A_FONT_SIZE: int = 9

# ── B 战场 ──────────────────────────────────────────────────────
#
# **这四个数是战场坐标系的定义**，[PBEnemyPool] 的 `to_screen` / `to_field`
# 全靠它们。改这里等于改「一个战场单位等于多少像素」，
# 而射程圈、大招半径、落点预示都是按那个比例画的。

## 战场那条道的上沿。
##
## M4-a 之前是 138–194 那条 56 像素的窄缝（出战席横排占了 96–130）。
## 纵向开始算数之后 56 像素装不下任何阵型：近战射程 0.12 换算过来
## 就是 67 像素，**一个人的射程圈比整条道还高**。
##
## 上下两头都不能越界：M4-f 之后玩家会把忍者拖到道的边缘，
## 而伸进面板底下的那一截会让人「消失」。
const FIELD_TOP: float = 34.0

## 战线的左右端点：右边出生，左边是基地。
## 「前中后」映射到屏幕右中左，与敌人推进方向一致（§02）。
const FIELD_LEFT: float = 128.0
const FIELD_RIGHT: float = 628.0

## 战场纵向的**画布**下沿 —— 也就是 B 这个框到哪儿为止。
##
## **真正的判定下沿是算出来的**（[method lane_bottom]，由
## [member PBSimConfig.field_height] 决定）。这个常量只是同一个数的
## 「写下来的样子」，两处必须对上：`34 + 0.44 × 500 = 254`。
## 对不上的表现是「打得到的敌人画在道外面」。
##
## 底栏从 260 起，加上 [constant B_LANE_INSET] 那 4 像素底板，
## 中间还剩 2 像素 —— **纵深已经顶到头了**，再往下要先动底栏。
const FIELD_BOTTOM: float = 254.0

const B_FIELD := Rect2(
	FIELD_LEFT, FIELD_TOP, FIELD_RIGHT - FIELD_LEFT, FIELD_BOTTOM - FIELD_TOP
)

## 战场底板比判定区大一圈，好让玩家看出「这条道到哪儿为止」。
## 横向比纵向多留一点 —— 敌人是从右边走进来的，右端要看得出还有路。
const B_LANE_INSET := Vector2(6.0, 4.0)

## 大本营那一竖条的宽度。它贴在 [constant FIELD_LEFT] 左边 ——
## 敌人走到 x=0 就是走到了它身上。
const B_BASE_WIDTH: float = 10.0

# ── C / D / E 左侧一列 ──────────────────────────────────────────

## 尾兽形象。点它 → [constant H_INFO] 显示尾兽信息、[constant J_COMMAND] 显示尾兽操作。
##
## **两个按钮尺寸必须一致**（[PBFieldSlots] 拿 `C_BEAST.size` 当统一的槽位大小）。
##
## M5-6 从 44 压到 36：那两个按钮里只有两行字（「尾兽 / Lv1」），
## 富余的 8 像素让给了 E —— 4 个任务槽是硬尺寸，字不是。
const C_BEAST := Rect2(12.0, 30.0, 100.0, 36.0)

## 大本营形象。同上。
const D_BASE := Rect2(12.0, 70.0, 100.0, 36.0)

## 任务栏：当前任务 + 4 个忍者槽（SSS 级派 4 人是 `QUEST_TABLE` 的上限）。
##
## **宽度从 548 掉到 100**：那三行散文（「本波任务 A 级 奖励 250 金…」）
## 一行都写不下，M5-6 重排成短句 + 图标，长句进 [PBTooltip]。
##
## **4 个槽排成 2×2，不是一横排。** 格子 30 宽（[constant PBUnitTile.TILE_SIZE]），
## 四个横着要 120，而这块只有 100 —— 一横排的代价是这一列整体变宽，
## 而它右边紧挨着战场的左沿（[constant FIELD_LEFT]）。
##
## 下沿正好是 [constant FIELD_BOTTOM]：左边这一列和战场一起收在同一条线上。
const E_QUEST := Rect2(12.0, 112.0, 100.0, 142.0)

# ── F ~ J 底栏 ──────────────────────────────────────────────────
#
# 五块一横排，**左右各留 6、块间也留 6**。M5-6 把整排往左收了 4 像素、
# 块间从 8 压到 6，省出来的 12 全给了 J —— 指令卡那 3×3 是
# 这一排唯一**放不下就出界**的东西（格子宽度乘以三，误差也乘以三），
# 其余四块少 2 像素看不出来。

## 忍者仓库。滚动，30 格 —— 角色表正好 30 个，而重复的卡并成星级，
## 所以这个上限现在是自动满足的（角色表扩到 31 个时它才变成一条真规则）。
const F_ROSTER := Rect2(6.0, 260.0, 130.0, 94.0)

## 忍具仓库。滚动，50 格。**那个上限现在只是显示容量，不是游戏规则** ——
## 配件在 core 里是「种类 → 个数」的计数，没有格子也没有上限。
## 要做成真上限得先回答「满了怎么办」（不让买 / 自动合成 / 溢出丢弃）。
const G_PARTS := Rect2(142.0, 260.0, 110.0, 94.0)

## 信息栏。**两种模式**：没选中人时显示队伍账（羁绊几档、再补一人进哪档），
## 选中了人就显示他的属性 —— 和 [constant J_COMMAND] 是同一条规矩。
const H_INFO := Rect2(258.0, 260.0, 132.0, 94.0)

## 忍者装备栏，3 格。只在信息栏显示某个忍者时出现。
const I_EQUIP := Rect2(396.0, 260.0, 44.0, 94.0)

## 操作栏。选中谁就显示谁能做的事。
##
## 3×3 的格子从 74×26 缩到 **58×23**。CLAUDE.md 早就记着「74 写不下整句」，
## 58 只会更写不下 —— 所以 M5-5 的 tooltip 不是锦上添花，是这块面板的前提。
##
## **M5-2 到 M5-6 之间格子一直是 74，而框已经缩到 174** ——
## 第三列从 614 一路画到 688，**出界 48 像素**，底下那行提示也垂到 368。
## 三个里程碑没发现，因为它不报错（见类顶部）。宽度补到 188 是
## 把整排往左收 4、块间从 8 压到 6 省出来的。
const J_COMMAND := Rect2(446.0, 260.0, 188.0, 94.0)

# ── 模态弹层 ────────────────────────────────────────────────────

## 模态弹层的宽度（[PBModal]）。**比 B 宽**（600 vs 500）——
## 它不是战场上的一块面板，是盖在整个画面上的一层，
## 对齐 B 只会让三选一那三张卡各窄掉 33 像素。
const MODAL_WIDTH: float = 600.0


## 一层高 [param height] 的模态弹层摆在哪。**横向居中于屏幕，纵向居中于 B。**
##
## 纵向不居中于屏幕是因为底栏那五块（F~J）在 260 以下 ——
## 居中会让弹层压住它们的上沿，而弹层关掉的那一瞬间玩家的视线
## 正要回到那儿。压在 B 上则不影响：准备阶段战场归玩家看，而
## **这两块弹层都是「不选就不能继续」**，此刻没有别的事可做。
static func modal_rect(height: float) -> Rect2:
	# **纵向钳在屏幕里。** 一层比 B 还高的弹层照上面那个式子算会垂到界外，
	# 而垂出去的正是底下那截 —— 提示行和确认按钮都在那儿。
	var top: float = FIELD_TOP + maxf((B_FIELD.size.y - height) * 0.5, 0.0)
	return Rect2(
		(SCREEN.x - MODAL_WIDTH) * 0.5,
		clampf(top, 0.0, maxf(SCREEN.y - height, 0.0)),
		MODAL_WIDTH,
		height
	)


# ── 战场坐标换算 ────────────────────────────────────────────────
#
# 这四个函数原来住在 [PBEnemyPool] 里。**它们算的是排版不是敌人** ——
# 己方单位、子弹、落点预示、伤害飘字、鼠标点选全都走它们，
# 而挂在敌人池上会让人以为「换算是敌人的事」，于是给己方另写一份。


## 一个战场单位在屏幕上换算成多少像素。
##
## **两轴共用这一个比例。** 各算各的话，sim 里的一个圆在屏幕上会是椭圆 ——
## 而 §02 的射程圈、大招落点预示都要求玩家看到的形状就是判定的形状。
static func px_per_unit(field: Vector2) -> float:
	return (FIELD_RIGHT - FIELD_LEFT) / maxf(field.x, 0.001)


## 战场那条道的下沿。**从战场高度算出来，不是常量** ——
## 写死一个数的话，改 [member PBSimConfig.field_height] 就会让画面
## 和判定悄悄错开，而那种错开只表现为「打得到的敌人画在道外面」。
static func lane_bottom(field: Vector2) -> float:
	return FIELD_TOP + field.y * px_per_unit(field)


## 战场坐标 → 屏幕坐标。**全项目唯一一份。**
##
## 各写一份的话，「预示圈盖住的位置」和「真正挨打的位置」会差几个像素，
## 而那种偏差看起来只是「大招好像打偏了」。
##
## [param field] 是 `Vector2(field_length, field_height)`。
static func to_screen(at: Vector2, field: Vector2) -> Vector2:
	var scale: float = px_per_unit(field)
	return Vector2(FIELD_LEFT + at.x * scale, FIELD_TOP + at.y * scale)


## 屏幕坐标 → 战场坐标。[method to_screen] 的逆，用来把鼠标点到的地方
## 换算回 sim 认得的位置（§02 的战斗中点选，M4-e）。
##
## 和正向那一份**必须成对改**：各写各的话，玩家点到的和实际选中的
## 会差几个像素，而那种偏差表现为「点边上一点就选不中」。
static func to_field(at: Vector2, field: Vector2) -> Vector2:
	var scale: float = px_per_unit(field)
	return Vector2((at.x - FIELD_LEFT) / scale, (at.y - FIELD_TOP) / scale)


## 把上面这些矩形贴到场景节点上。
##
## **`.tscn` 里不再写死这些数。** 写死的话改一次排版要在场景和这个文件
## 两处各改一遍，而两处对不上只表现为「底板和判定区错开几个像素」——
## 那正是 M3.5-e 改版时基地血条犯过的错：道从 95–300 缩到 134–198，
## 而血条还按旧的底边画，满血时整根条盖住了羁绊带。
static func apply_to(
	lane: ColorRect,
	base: ColorRect,
	limit: ColorRect,
	info: Label,
	preview: Label,
	field: Vector2,
	limit_x: float
) -> void:
	var bottom: float = lane_bottom(field)
	lane.position = B_FIELD.position - B_LANE_INSET
	lane.size = Vector2(B_FIELD.size.x, bottom - FIELD_TOP) + B_LANE_INSET * 2.0
	base.position.x = FIELD_LEFT - B_BASE_WIDTH
	base.size.x = B_BASE_WIDTH
	# 界限是屏幕上那条竖线（M4-f）。**它的 x 是算出来的**，
	# 因为夹取用的是 `deploy_limit_x`，两处对不上的表现是
	# 「拖到线上松手，人却弹回去一点」。
	limit.position = Vector2(to_screen(Vector2(limit_x, 0.0), field).x - 1.0, FIELD_TOP)
	limit.size = Vector2(2.0, bottom - FIELD_TOP)
	for pair: Array in [[info, A_INFO], [preview, A_PREVIEW]]:
		var label := pair[0] as Label
		var rect := pair[1] as Rect2
		label.position = rect.position
		label.size = rect.size
		label.add_theme_font_size_override(&"font_size", A_FONT_SIZE)
