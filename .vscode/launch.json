{
  // F5 断点调试。断点直接打在 .gd 文件行号上，变量、调用栈、
  // 远程场景树都在 VSCode 侧面板里看 —— 不用切回 Godot 编辑器。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot: 运行主场景",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "debug_collisions": false,
      "debug_navigation": false
    },
    {
      "name": "Godot: 运行当前打开的场景",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      // "current" = 用编辑器里当前选中的场景；也可写死 "res://scenes/xxx.tscn"
      "scene": "current"
    },
    {
      // 战场形象预览台（PBActorLab，M6-e）：挑一个忍者，一段段放他的动作。
      // 接真素材时看这里 —— 信息栏直接写着「这张皮是装上了还是退回了白模」，
      // 而在战斗画面里那件事看不出来（小人 27 像素高、还被别人挡着）。
      "name": "Godot: 战场形象预览台",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "scene": "res://scenes/actor_lab.tscn"
    },
    {
      "name": "Godot: 运行 + 显示碰撞体",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "debug_collisions": true,
      "debug_paths": true,
      "debug_navigation": true
    },
    {
      "name": "Godot: 慢动作 0.2x（调手感用）",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "time_scale": 0.2
    }
  ]
}
