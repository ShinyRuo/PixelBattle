# Godot 的场景和资源是文本格式 —— 这是相比 UE .uasset 最大的红利：
# diff 可读、能 merge、AI 能直接改。这里显式声明成文本，防止 Git 猜错。

* text=auto eol=lf

*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.gdshader  text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ps1       text eol=crlf

# 二进制资产：禁止 Git 做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.svg   text eol=lf
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.scn   binary
*.res   binary
